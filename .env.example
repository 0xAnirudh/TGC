# Copy to .env and fill in. .env is gitignored and must never be committed.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB. Local docker-compose default, or an Atlas connection string.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=tgc

# Redis 7+. Must support EVAL (Lua) and Streams - phases 5 and 6 depend
# on both. Local docker-compose default, or an Upstash rediss:// URL.
REDIS_URL=redis://localhost:6379

# Auth. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-at-least-16-characters
JWT_TTL=7d
