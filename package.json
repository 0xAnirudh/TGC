{
  "name": "tgc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "General Company - a player-driven virtual economy",
  "workspaces": [
    "packages/*",
    "sim"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node sim/src/run.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "loadtest": "node loadtest/run.mjs",
    "dev": "concurrently -n api,relay,jobs,web -c cyan,magenta,yellow,green \"npm:dev:api\" \"npm:dev:relay\" \"npm:dev:jobs\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace=@tgc/api",
    "dev:relay": "npm run dev --workspace=@tgc/relay",
    "dev:jobs": "npm run dev --workspace=@tgc/jobs",
    "dev:web": "npm run dev --workspace=@tgc/web",
    "seed": "npm run seed --workspace=@tgc/api",
    "rebuild": "npm run rebuild --workspace=@tgc/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
